# ==============================================================================
# CSUCI Student Success Navigator — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values.
# These variables are used by Lambda functions and for local development.
# ==============================================================================

# Amazon Bedrock Knowledge Base ID (from the Bedrock console)
BEDROCK_KB_ID=your-knowledge-base-id-here

# Bedrock model identifier for the LLM.
# Must be a tool-use-capable model. Claude models on Bedrock are
# inference-profile only — use the "us."-prefixed profile ID.
MODEL_ID=us.anthropic.claude-sonnet-5

# Fast/cheap model for auxiliary steps (history-aware retrieval query
# rewriting). Runs only on follow-up turns. Defaults to a Haiku profile.
REWRITE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Bedrock Guardrail ID and version (from the Bedrock console -> Guardrails ->
# your guardrail -> Versions tab, after creating at least one version).
# Use "DRAFT" for the working draft, or a numbered version (e.g. "1") once
# you've published one for a stable demo.
GUARDRAIL_ID=your-guardrail-id-here
GUARDRAIL_VERSION=DRAFT

# SNS topic ARN for escalation notifications (optional)
SNS_TOPIC_ARN=arn:aws:sns:us-west-2:123456789012:csuci-escalation-topic

# AWS region
AWS_REGION=us-west-2
