# ==============================================================================
# CSUCI Student Success Navigator — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values.
# These variables are used by Lambda functions and for local development.
# ==============================================================================

# Amazon Bedrock Knowledge Base ID (from the Bedrock console)
BEDROCK_KB_ID=your-knowledge-base-id-here

# Bedrock model identifier for the LLM.
# Must be a tool-use-capable model. Claude models on Bedrock are
# inference-profile only — use the "us."-prefixed profile ID.
MODEL_ID=us.anthropic.claude-sonnet-5

# SNS topic ARN for escalation notifications (optional)
SNS_TOPIC_ARN=arn:aws:sns:us-west-2:123456789012:csuci-escalation-topic

# AWS region
AWS_REGION=us-west-2
